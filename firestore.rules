rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Fields: uid, email, displayName, balance, role, createdAt
    //
    // Collection: categories
    // Fields: name, icon
    //
    // Collection: services
    // Fields: name, categoryId, price, description, imageUrl
    //
    // Collection: orders
    // Fields: userId, serviceId, serviceName, playerAppId, amount, status, createdAt
    //
    // Collection: deposits
    // Fields: userId, userEmail, amount, status, createdAt
    //
    // Collection: transactions
    // Fields: id, userId, amount, transactionType, status, createdAt
    //
    // Collection: settings
    // Fields: imageUrl, title, subtitle, link, isActive
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (request.auth.token.email == "sameralsoub@gmail.com" && request.auth.token.email_verified == true) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isModerator() {
      return isAuthenticated() &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator');
    }

    function hasAdminAccess() {
      return isAdmin() || isModerator();
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'balance', 'role', 'displayName', 'createdAt']) &&
             data.uid is string &&
             data.email is string &&
             data.balance is number &&
             data.role in ['user', 'moderator', 'admin'] &&
             data.displayName is string &&
             data.createdAt is string;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'serviceId', 'serviceName', 'playerAppId', 'amount', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.amount is number &&
             data.status == 'pending';
    }

    function isValidDeposit(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'amount', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.status == 'waiting';
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'userId', 'amount', 'transactionType', 'status', 'createdAt']) &&
             data.userId == request.auth.uid;
    }

    // Rules
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || hasAdminAccess());
      allow list: if hasAdminAccess();
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUser(request.resource.data) && 
                    (
                      (request.resource.data.role == 'admin' && request.auth.token.email == "sameralsoub@gmail.com") ||
                      (request.resource.data.role == 'user' && request.resource.data.balance == 0)
                    );
      allow update: if isAdmin();
      allow update: if isAuthenticated() && request.auth.uid == userId && 
                     request.resource.data.role == resource.data.role &&
                     request.resource.data.balance <= resource.data.balance;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isAuthenticated() && (request.auth.uid == resource.data.userId || hasAdminAccess());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || hasAdminAccess());
      allow create: if isAuthenticated() && isValidOrder(request.resource.data);
      allow update: if hasAdminAccess();
      allow delete: if false;
    }

    match /deposits/{depositId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || hasAdminAccess());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || hasAdminAccess());
      allow create: if isAuthenticated() && isValidDeposit(request.resource.data);
      allow update: if hasAdminAccess();
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || hasAdminAccess());
      allow create: if isAuthenticated() && isValidTransaction(request.resource.data);
      allow update: if hasAdminAccess();
      allow delete: if false;
    }

    match /stats/{date} {
      allow read: if hasAdminAccess();
      allow create, update: if true; // Allow anyone to increment visitor count
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
